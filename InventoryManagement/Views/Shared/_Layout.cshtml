@using InventoryManagement.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryManagement.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">IMS</a>
            <p class="brand-sub">Inventory Management</p>
            <nav class="side-nav">
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="side-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
                    <a class="side-link" asp-controller="Users" asp-action="Index">Users</a>
                    <a class="side-link" asp-controller="Backlog" asp-action="Index">Backlog</a>
                }
                @if (User.IsInRole(AppRoles.InventoryManager))
                {
                    <a class="side-link" asp-controller="Inventory" asp-action="Index">Dashboard</a>
                    <a class="side-link" asp-controller="Products" asp-action="Index">Products</a>
                    <a class="side-link" asp-controller="Suppliers" asp-action="Index">Sellers</a>
                    <a class="side-link" asp-controller="PurchaseOrders" asp-action="Index">Purchases</a>
                    <a class="side-link" asp-controller="PurchaseOrders" asp-action="Create">New purchase</a>
                    <a class="side-link" asp-controller="Backlog" asp-action="Index">Backlog</a>
                }
                @if (User.IsInRole(AppRoles.SalesTeam))
                {
                    <a class="side-link" asp-controller="Sales" asp-action="Index">Dashboard</a>
                    <a class="side-link" asp-controller="SaleOrders" asp-action="Index">Sales orders</a>
                    <a class="side-link" asp-controller="SaleOrders" asp-action="Create">New sale</a>
                    <a class="side-link" asp-controller="Backlog" asp-action="Index">Backlog</a>
                }
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="side-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                }
            </nav>
        </aside>
        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <partial name="_LoginPartial" />
            </header>
            <main class="app-content">
                @if (TempData["Status"] is string status)
                {
                    <div class="alert alert-success">@status</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </main>
            @* <footer class="app-footer">Inventory Management System · .NET 10</footer> *@
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
