@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-success" asp-action="Create">Add product</a>
</div>
<div class="panel p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Stock</th>
                <th>Alert at</th>
                <th>Avg cost</th>
                <th>Suggested price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr class="@(p.IsLowStock ? "table-warning" : "")">
                <td>@p.Name</td>
                <td>@p.Sku</td>
                <td>@p.CurrentStock</td>
                <td>@p.ReorderLevel</td>
                <td>@p.AverageCost.ToString("N2")</td>
                <td>@p.SuggestedPrice.ToString("N2")</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
