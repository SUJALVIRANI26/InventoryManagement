@model IEnumerable<Supplier>
@{
    ViewData["Title"] = "Sellers";
}

<div class="d-flex justify-content-end mb-3">
    <a class="btn btn-success" asp-action="Create">Add seller</a>
</div>
<div class="panel p-0">
    <table class="table mb-0">
        <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.ContactPerson</td>
                <td>@s.Phone</td>
                <td>@s.Email</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
