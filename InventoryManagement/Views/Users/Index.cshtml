@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between mb-3">
    <p class="text-muted mb-0">Admin can create inventory managers and sales team accounts only.</p>
    <a class="btn btn-success" asp-action="Create">Create user</a>
</div>

<div class="panel p-0">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.User.FullName</td>
                <td>@row.User.Email</td>
                <td>@AppRoles.DisplayName(row.Role)</td>
                <td>@(row.User.IsActive ? "Active" : "Inactive")</td>
                <td class="text-end">
                    @if (row.Role != AppRoles.Admin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@row.User.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@row.User.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Delete this user?');">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
